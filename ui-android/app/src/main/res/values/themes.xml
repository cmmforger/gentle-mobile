<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app theme (design/system.md — Gentleman-Cute, bg #1A1218). -->
    <style name="Theme.GentleMobile" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/gm_window_background</item>
        <item name="android:statusBarColor">@color/gm_window_background</item>
        <item name="android:navigationBarColor">@color/gm_window_background</item>
    </style>

    <!-- Launch theme: the splash from 01-pair.html — the real logo centered
         on the brand background. MainActivity switches to Theme.GentleMobile
         before its first composed frame; on Android 12+ the system splash
         also uses the new launcher icon. -->
    <style name="Theme.GentleMobile.Launch">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
