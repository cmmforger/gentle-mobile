<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The scanner is optional: without a camera the app falls back to the
         paste field, so the app must still install on camera-less devices. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- The one-scan pairing POST (S22) is plain HTTP on purpose: it
         carries only the device's public key and the one-time token —
         never a secret. Everything else (the transport) is SSH. -->
    <application
        android:label="Gentle Mobile"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.GentleMobile.Launch">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
