<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- T15 (S11): the foreground service that keeps the SSH link alive in
         the background, plus the runtime permission for the agent alerts.
         Android 14 (targetSdk 34) requires the dataSync FGS type to be
         declared with FOREGROUND_SERVICE_DATA_SYNC; the service names the
         same type when it calls startForeground. No relay, no push
         service: the phone holds the SSH link itself (S11). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The scanner is optional: without a camera the app falls back to the
         paste field, so the app must still install on camera-less devices. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- T14 (S8): dictation is speech turned into text. The on-device
         recognizer needs no permission and no audio leaves the phone; the
         standard fallback reads the microphone, so RECORD_AUDIO is declared
         here and requested only at the moment the mic is tapped — and the
         app must still install (and run without dictation) on mic-less
         devices. No audio is ever recorded or kept beyond the request. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- T13: the composer's camera intent targets whatever camera app the
         device has; without this query the lookup is filtered on Android 11+. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- The one-scan pairing POST (S22) is plain HTTP on purpose: it
         carries only the device's public key and the one-time token —
         never a secret. Everything else (the transport) is SSH. -->
    <application
        android:label="Gentle Mobile"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.GentleMobile.Launch">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- T15 (S11): the foreground service, stopped exactly when the
             connection ends or the user disconnects (ForegroundServiceGate). -->
        <service
            android:name=".notifications.ConnectionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- T13: camera photos are written to a provider-owned cache file —
             the camera intent needs a content URI, and this way the app
             needs no storage permission at all. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.attachments"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
