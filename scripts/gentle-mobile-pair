#!/usr/bin/env bash
# gentle-mobile-pair — set up a phone to reach this machine, in one scan.
#
#   gentle-mobile-pair                 start the one-scan pairing listener:
#                                      prints a QR, waits for the phone's
#                                      key, trusts it, and exits
#   gentle-mobile-pair --add-key KEY   manual fallback: trust one key by hand
#   gentle-mobile-pair --list          list the keys this tool added
#   gentle-mobile-pair --revoke        remove every key this tool added
#
# The listener is single use: one token, one key, a short TTL (default
# 180 s), and it binds the LAN/Tailscale address — never loopback-only.
# It never touches keys it did not add: everything carries the marker
# below, so --revoke is exact and leaves other authorized keys alone. The
# marker was renamed from gentle-companion to gentle-mobile before anything
# shipped, so --revoke also cleans keys carrying the old marker — nothing
# is orphaned.
set -euo pipefail

MARKER="gentle-mobile"
# The pre-rename marker; --list still shows those keys and --revoke removes
# them so nothing added under the old name is orphaned.
LEGACY_MARKER="gentle-companion"
AUTHORIZED="${AUTHORIZED_KEYS:-$HOME/.ssh/authorized_keys}"
PORT="${GENTLE_COMPANION_PORT:-22}"

die() { printf '%s\n' "$*" >&2; exit 1; }

# Prefer Tailscale (works off-LAN) and fall back to the LAN address.
host_address() {
    if command -v tailscale >/dev/null 2>&1; then
        local ip
        ip=$(tailscale ip -4 2>/dev/null | head -n1 || true)
        if [ -n "${ip:-}" ]; then printf '%s' "$ip"; return; fi
    fi
    ip route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i <= NF; i++) if ($i == "src") { print $(i + 1); exit }}'
}

usage() { sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in
--add-key)
    key="${2:-}"
    [ -n "$key" ] || die "usage: gentle-mobile-pair --add-key 'ssh-ed25519 AAAA... comment'"
    case "$key" in
        ssh-ed25519\ *|ssh-rsa\ *|ecdsa-sha2-*\ *) ;;
        *) die "that does not look like an SSH public key" ;;
    esac
    mkdir -p "$(dirname "$AUTHORIZED")"
    touch "$AUTHORIZED"
    chmod 600 "$AUTHORIZED"
    if grep -qF "$key" "$AUTHORIZED"; then
        printf 'already trusted\n'
        exit 0
    fi
    # Keep the phone's own trailing comment, append ours so --revoke can find it.
    printf '%s %s-%s\n' "$(printf '%s' "$key" | awk '{$NF=""; print}' | sed 's/[[:space:]]*$//')" \
        "$MARKER" "$(date +%Y%m%d-%H%M%S)" >> "$AUTHORIZED"
    printf 'key added to %s\n' "$AUTHORIZED"
    ;;
--list)
    found=0
    while IFS= read -r line; do
        case "$line" in
            *"$MARKER-"*|*"$LEGACY_MARKER-"*)
                printf '%s\n' "$line" | awk '{print $1, $2, $NF}'
                found=1
                ;;
        esac
    done < "$AUTHORIZED" 2>/dev/null
    [ "$found" -eq 1 ] || printf 'no phone keys yet\n'
    ;;
--revoke)
    [ -f "$AUTHORIZED" ] || die "no $AUTHORIZED"
    tmp=$(mktemp)
    grep -vF -e "$MARKER-" -e "$LEGACY_MARKER-" "$AUTHORIZED" > "$tmp" || true
    cat "$tmp" > "$AUTHORIZED"
    rm -f "$tmp"
    printf 'removed every key this tool added (including old gentle-companion markers); other keys untouched\n'
    ;;
-h|--help|help)
    usage
    ;;
"")
    # One-scan pairing: a single-use listener with a short TTL, advertising
    # everything the phone needs in one gc:// link.
    user="${GENTLE_COMPANION_USER:-$(id -un)}"
    # Bind the LAN/Tailscale address: tailscale first (works off-LAN), then
    # the LAN address. GENTLE_MOBILE_PAIR_BIND pins one on multi-IP hosts —
    # loopback stays refused in every case.
    bind="${GENTLE_MOBILE_PAIR_BIND:-$(host_address)}"
    [ -n "${bind:-}" ] || die "could not determine this machine's address"
    case "$bind" in
        127.*|::1) die "refusing to pair on a loopback address ($bind): the phone could not reach it" ;;
    esac
    command -v python3 >/dev/null 2>&1 || die "python3 is required for the pairing listener"
    exec python3 - "$bind" "$PORT" "$user" "$AUTHORIZED" "$MARKER" <<'PYLISTENER'
import base64
import datetime
import hmac
import json
import os
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

SSH_HOST, SSH_PORT, USER, AUTHORIZED, MARKER = sys.argv[1:6]
SSH_PORT = int(SSH_PORT)
TTL = int(os.environ.get("GENTLE_MOBILE_PAIR_TTL", "180"))
PAIR_PORT = int(os.environ.get("GENTLE_MOBILE_PAIR_PORT", "0"))
TOKEN = os.urandom(24).hex()
# After success (or expiry) the listener stays up briefly so a second
# attempt gets an explicit refusal instead of a dead connection.
GRACE_S = 10
MAX_BODY = 8192

KEY_TYPES = {
    "ssh-ed25519",
    "ssh-rsa",
    "ecdsa-sha2-nistp256",
    "ecdsa-sha2-nistp384",
    "ecdsa-sha2-nistp521",
    "sk-ssh-ed25519@openssh.com",
    "sk-ecdsa-sha2-nistp256@openssh.com",
}


def validate_key(raw):
    """Return (keytype, blob) for one well-formed SSH public key, else (None, reason)."""
    if raw is None:
        return None, "the request must carry a key"
    key = raw.strip()
    if not key:
        return None, "the request must carry a key"
    if "\n" in key or "\r" in key:
        return None, "the body must be exactly one key line, not a key file"
    parts = key.split()
    if len(parts) < 2:
        return None, "not an SSH public key (expected: type base64-blob [comment])"
    ktype, blob = parts[0], parts[1]
    if ktype not in KEY_TYPES:
        return None, f"unsupported key type {ktype!r}"
    try:
        decoded = base64.b64decode(blob, validate=True)
    except Exception:
        return None, "the key blob is not valid base64"
    # The blob's wire form starts with its own type string; anything else is
    # not a real key, however base64-plausible it looks.
    n = len(decoded)
    if n < 4:
        return None, "the key blob is truncated"
    inner_len = int.from_bytes(decoded[:4], "big")
    if inner_len != len(ktype) or decoded[4 : 4 + inner_len] != ktype.encode():
        return None, "the key blob does not match its declared type"
    if n < 4 + inner_len + 4:
        return None, "the key blob is truncated"
    return ktype, blob


class Pairing:
    def __init__(self):
        self.lock = threading.Lock()
        self.used = False
        self.expired = False
        self.server = None

    def burn(self):
        with self.lock:
            self.used = True


def respond(handler, status, payload):
    body = json.dumps(payload).encode()
    handler.send_response(status)
    handler.send_header("Content-Type", "application/json")
    handler.send_header("Content-Length", str(len(body)))
    handler.end_headers()
    handler.wfile.write(body)


def make_handler(pairing):
    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass  # the console shows outcomes, not request noise

        def do_POST(self):
            length = int(self.headers.get("Content-Length") or 0)
            if length <= 0 or length > MAX_BODY:
                respond(self, 400, {"ok": False, "error": "missing or oversized request body"})
                return
            try:
                data = json.loads(self.rfile.read(length))
            except Exception:
                respond(self, 400, {"ok": False, "error": "the body is not a pairing request"})
                return
            if not isinstance(data, dict):
                respond(self, 400, {"ok": False, "error": "the body is not a pairing request"})
                return

            if pairing.expired:
                respond(self, 403, {"ok": False, "error": "pairing expired — run gentle-mobile-pair on the host and start again"})
                return
            token = data.get("token")
            if not isinstance(token, str) or not hmac.compare_digest(token, TOKEN):
                respond(self, 401, {"ok": False, "error": "wrong token — this link does not match the running listener"})
                return

            with pairing.lock:
                if pairing.used:
                    respond(self, 409, {"ok": False, "error": "already used — this pairing was consumed; run gentle-mobile-pair again"})
                    return
                ktype, blob = validate_key(data.get("key"))
                if ktype is None:
                    respond(self, 400, {"ok": False, "error": f"not a single well-formed SSH public key: {blob}"})
                    return
                line = f"{ktype} {blob} {MARKER}-{datetime.datetime.now().strftime('%Y%m%d-%H%M%S')}"
                try:
                    os.makedirs(os.path.dirname(AUTHORIZED) or ".", exist_ok=True)
                    with open(AUTHORIZED, "a+") as f:
                        f.seek(0)
                        existing = f.read()
                        if f"{ktype} {blob}" in existing:
                            written = None  # already trusted
                        else:
                            f.seek(0, os.SEEK_END)
                            f.write(line + "\n")
                            f.flush()
                            os.fsync(f.fileno())
                            written = line
                    os.chmod(AUTHORIZED, 0o600)
                except OSError as e:
                    respond(self, 500, {"ok": False, "error": f"the host could not write {AUTHORIZED}: {e}"})
                    return
                pairing.used = True

            if written is None:
                respond(self, 200, {"ok": True, "written": "already trusted"})
                print(f"\n[ok] that key was already trusted — nothing written to {AUTHORIZED}", flush=True)
            else:
                respond(self, 200, {"ok": True, "written": written})
                print(f"\n[ok] key trusted — wrote exactly this to {AUTHORIZED}:", flush=True)
                print(written, flush=True)
            threading.Thread(target=self.close_soon, daemon=True).start()

        def close_soon(self):
            time.sleep(GRACE_S)
            pairing.server.shutdown()

    return Handler


def main():
    server = ThreadingHTTPServer((SSH_HOST, PAIR_PORT), make_handler(pairing))
    pairing.server = server
    port = server.server_address[1]
    advertise = os.environ.get("GENTLE_MOBILE_PAIR_ADDR") or SSH_HOST
    link = f"gc://{SSH_HOST}:{SSH_PORT}?user={USER}&pair={advertise}:{port}&t={TOKEN}"
    minutes = max(1, round(TTL / 60))
    print(f"[QR]   single use · expires in {minutes} minutes", flush=True)
    print(f"pair   {advertise}:{port} · ssh {SSH_PORT} · user {USER}", flush=True)
    print(f"scan it with Gentle Mobile — no key to copy.", flush=True)
    print(f"link:  {link}", flush=True)
    if subprocess.run(["qrencode", "-t", "ANSIUTF8", link]).returncode != 0:
        print("qrencode failed; paste the link line above into the app.", flush=True)

    def expire():
        time.sleep(TTL)
        with pairing.lock:
            if not pairing.used:
                pairing.expired = True
                print(f"\n[!] the pairing expired after {TTL}s — every request is now refused", flush=True)
        time.sleep(GRACE_S)
        pairing.server.shutdown()

    threading.Thread(target=expire, daemon=True).start()
    print("waiting for the phone… (Ctrl-C to cancel)", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    server.server_close()


pairing = Pairing()
main()
PYLISTENER
    ;;
*)
    die "unknown option: ${1:-} (try --help)"
    ;;
esac
